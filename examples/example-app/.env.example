PORT=3000
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token
UPSTASH_REDIS_KEY_PREFIX=nosql_odm_example
QSTASH_URL=http://localhost:8081

# Required only for POST /migrations/start.
# The local QStash dev server prints this when it starts.
QSTASH_TOKEN=

# Required when QStash cannot call the app through the request origin.
# For local external tunneling, set this to the public tunnel URL.
APP_BASE_URL=http://localhost:3000
